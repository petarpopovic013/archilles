{
  "name": "archilles",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev",
    "dev:runtime": "node --env-file-if-exists=.env --watch --import tsx runtime/main.ts",
    "start:runtime": "node --env-file-if-exists=.env --import tsx runtime/main.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test",
    "postinstall": "next typegen",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@mozaik-ai/core": "^4.2.0",
    "better-sqlite3": "^13.0.3",
    "konva": "^10.9.0",
    "next": "16.4.3",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "^19.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
